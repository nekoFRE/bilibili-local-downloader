{
  "manifest_version": 3,
  "name": "B站视频下载器 · 本地助手",
  "version": "1.2.2",
  "description": "在B站视频页选择画质和分P，交给本机下载器生成MP4，或用Edge直接下载音视频。",
  "permissions": ["activeTab", "tabs", "scripting", "cookies", "downloads", "storage", "declarativeNetRequestWithHostAccess"],
  "host_permissions": [
    "https://*.bilibili.com/*",
    "https://b23.tv/*",
    "https://*.bilivideo.com/*",
    "https://*.bilivideo.cn/*",
    "http://127.0.0.1:17890/*"
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_icon": "icons/icon48.png" },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "content_scripts": [{
    "matches": ["https://www.bilibili.com/*", "https://bilibili.com/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }],
  "web_accessible_resources": [{
    "resources": ["popup.html"],
    "matches": ["https://*.bilibili.com/*"]
  }],
  "options_page": "options.html"
}
